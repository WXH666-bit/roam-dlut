# 服务监听与公网地址
PORT=9091
PUBLIC_BASE_URL=http://1.92.120.33:9091

# 自托管 Expo Updates。生产机建议填写绝对路径，避免受启动目录影响。
OTA_PUBLIC_BASE_URL=http://1.92.120.33:9091
OTA_UPDATES_DIR=/opt/roam-dlut/server/data/updates
OTA_PRIVATE_KEY_PATH=/opt/roam-dlut/server/data/ota/keys/private-key.pem

# 普通云服务器可直接把用户上传文件存在本机磁盘。
STORAGE_PROVIDER=local
# 可选；不设时复用 SERVER_SECRET，二者都未设置则每次进程启动随机生成。
# LOCAL_MEDIA_SIGNING_SECRET=replace-with-a-long-random-secret
# 可选；上传票据默认复用 SERVER_SECRET，二者都未设置则每次进程启动随机生成。
# MEDIA_UPLOAD_TOKEN_SECRET=replace-with-a-long-random-secret

# 正式环境请生成随机长字符串并取消注释；已上线后不要更换。
# SERVER_SECRET=replace-with-a-long-random-secret

# 内容审核只在服务端调用。请使用新生成的密钥；不要把真实值提交到 Git。
# STEPFUN_API_KEY=
STEPFUN_MODEL=step-3.7-flash
STEPFUN_BASE_URL=https://api.stepfun.com/v1
STEPFUN_TIMEOUT_MS=60000
MODERATION_CONCURRENCY=2
# 付费调用预算与匿名身份/上传限流；请按比赛人数和账户预算调整。
MODERATION_IP_HOURLY_LIMIT=30
MODERATION_GLOBAL_DAILY_LIMIT=500
REGISTRATION_IP_HOURLY_LIMIT=20
UPLOAD_IP_HOURLY_LIMIT=30
UPLOAD_DEVICE_HOURLY_LIMIT=20
UPLOAD_MAX_CONCURRENCY=2
# 被拒媒体和未发布上传的自动清理重试周期（最低 60000 毫秒）。
MEDIA_CLEANUP_INTERVAL_MS=900000
# 仅后端严格位于一层可信反向代理之后时开启。
# RATE_LIMIT_TRUST_PROXY=true

# 管理后台独立密钥。未配置时 /api/v1/admin/* 会拒绝所有请求。
# ADMIN_SECRET=replace-with-another-long-random-secret
# 公网后台默认强制 HTTPS；反向代理终止 TLS 时设为 true 并确保它覆盖客户端同名请求头。
# ADMIN_TRUST_PROXY=true
# 仅封闭演示网络临时使用，公网不建议开启。
# ADMIN_ALLOW_INSECURE_HTTP=false

# 可选：不设置 DATABASE_URL 时使用本地 JSON 持久化。
# DATABASE_URL=mysql://user:password@127.0.0.1:3306/cidi

# 可选：Expo Push Service access token；未设置时请求不附带鉴权 header。
# EXPO_ACCESS_TOKEN=
