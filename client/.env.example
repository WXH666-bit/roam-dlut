# 后端 API 地址（本地开发指向 mock 后端）
EXPO_PUBLIC_BACKEND_BASE_URL=http://localhost:9091
# 默认自动使用 <BACKEND_BASE_URL>/api/v1/updates/manifest；有独立 HTTPS/CDN 域名时再覆盖。
# EXPO_PUBLIC_OTA_UPDATE_URL=https://updates.example.com/api/v1/updates/manifest

# iOS 离线点赞推送需要 Expo/EAS 项目 ID；本地通知与 Android 守候不依赖它。
# EXPO_PUBLIC_EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000

# Android 高德融合定位 Key（绑定包名 com.roamdlut.cidi 与安装包签名 SHA-1）。
# 仅在重新生成/构建 Android 基座时读取，不会进入 JS 热更新包。
# AMAP_ANDROID_API_KEY=your_android_amap_key
