{
  "name": "expo-express-monorepo",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "pnpm --parallel -r --filter=./server --filter=./client run dev",
    "start": "pnpm --filter=./client run start",
    "preinstall": "npx only-allow pnpm",
    "lint:client": "pnpm --filter=./client run lint",
    "lint:server": "pnpm --filter=./server run lint",
    "validate": "pnpm dlx concurrently --group --names expo,server \"pnpm lint:client\" \"pnpm lint:server\""
  },
  "dependencies": {},
  "devDependencies": {},
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.27.2"
    },
    "patchedDependencies": {
      "expo@54.0.33": "patches/expo@54.0.33.patch"
    }
  }
}
